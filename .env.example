# Copy to .env; sudo docker compose reads this root file.
POSTGRES_USER=prisma
POSTGRES_PASSWORD=replace-with-a-long-local-password
POSTGRES_DB=prisma
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_DAYS=7
DEMO_STEP_SECONDS=0.8
# Optional Search/Fetch collection. No Agent or Browser fallback.
TINYFISH_ENABLED=false
TINYFISH_API_KEY=
TINYFISH_SEARCH_DAILY_LIMIT=100
TINYFISH_FETCH_DAILY_LIMIT=200
TINYFISH_CACHE_SECONDS=3600
TINYFISH_SEARCHES_PER_RUN=1
TINYFISH_FETCH_ATTEMPTS_PER_RUN=6
# Optional local model service; start with the inference Compose profile.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=all-minilm
MODEL_CONTEXT_TOKENS=4096
MODEL_OUTPUT_TOKENS=1200
MODEL_THREADS=3
# Hosted inference is opt-in. Verify your account's free quota before enabling.
ALLOW_HOSTED_MODELS=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_QUERY_MODEL=gemini-flash-lite-latest
ALLOW_HOSTED_QUERIES=true

# Larger profiles require explicit model names and a matching service memory budget.
ALLOW_LARGE_LOCAL_MODELS=false
OLLAMA_BALANCED_MODEL=
OLLAMA_ADVANCED_MODEL=
INFERENCE_MEMORY_BUDGET_BYTES=3000000000
OLLAMA_MEMORY_LIMIT=3g
OLLAMA_CPU_LIMIT=3
LOCAL_GPU_LAYERS=0
ANALYSIS_MAX_PASSAGES=48

# Set these to the active limits of your Google project (assumed free-tier quotas).
GEMINI_QUERY_RPM=6
GEMINI_QUERY_INPUT_TPM=120000
RESEARCH_TIMEOUT_SECONDS=60
RESEARCH_MAX_WAIT_SECONDS=65
RESEARCH_TOTAL_SECONDS=200
RESEARCH_RETRY_ATTEMPTS=3